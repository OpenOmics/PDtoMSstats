#!/usr/bin/env sh
set -eu

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker was not found. Install Docker Desktop or Docker Engine first." >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "Docker is installed but the Docker engine is not running." >&2
  exit 1
fi

if ! docker image inspect pdtomsstats:0.1.2 >/dev/null 2>&1; then
  echo "Downloading the PDtoMSstats environment for the first run..."
  if docker pull ghcr.io/openomics/pdtomsstats:0.1.2; then
    docker tag ghcr.io/openomics/pdtomsstats:0.1.2 pdtomsstats:0.1.2
  else
    echo "The published image could not be downloaded; building it locally..."
    docker compose build
  fi
fi

exec docker compose run --rm pdtomsstats \
  Rscript scripts/pdtomsstats.R "$@"
